    "onb.2.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضجيج، الازدحام، الواي فاي، المقابس، سعر القهوة: شارك الأجواء مباشرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noise, crowd, Wi-Fi, outlets, coffee price: share the vibe live."
