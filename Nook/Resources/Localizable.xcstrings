    "onb.1.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أساعدك في إيجاد مكان هادئ للدراسة: مقاهٍ ومكتبات ومساحات عمل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I help you find a quiet place to study: cafés, libraries, coworking spaces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je t'aide à trouver un endroit calme pour réviser : cafés, bibliothèques, coworkings."
          }
        }
      }
    },
    "onb.1.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
